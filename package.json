{
  "name": "todo-list",
  "version": "0.1.0",
  "description": "A minimalist outliner for macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "electron:dev": "npm run build:electron && ELECTRON_RENDERER_URL=http://localhost:5173 electron ."
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@types/node": "^22.0.0"
  }
}
