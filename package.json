{
  "name": "todo-list",
  "version": "0.1.0",
  "description": "A minimalist outliner for macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:icon": "node scripts/make-icon.js",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "electron:dev": "npm run build:electron && ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "dist": "npm run build:icon && npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.bonfire.todolist",
    "productName": "Todo List",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/tray.png", "to": "build/tray.png" },
      { "from": "build/tray@2x.png", "to": "build/tray@2x.png" }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
